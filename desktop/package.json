{
  "name": "freebuff-2api-macos-wrapper",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check main.js && node --check preload.js && node --check app-policy.js && node --check platform.js && node --check gateway.js && node --check login.js",
    "start": "electron .",
    "prepare:gateway": "node ../scripts/prepare-gateway.js",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "smoke:bundle": "node ../scripts/smoke-bundle.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  }
}
